# Modèle du fichier .env : copie ce fichier en ".env" puis remplace VOTRE_MOT_DE_PASSE.
# Le vrai fichier .env ne doit JAMAIS être envoyé sur GitHub (il est ignoré par .gitignore).

# Adresse de la base PostgreSQL : postgresql://utilisateur:mot_de_passe@serveur:port/nom_de_la_base
DATABASE_URL="postgresql://postgres:VOTRE_MOT_DE_PASSE@localhost:5432/vocabtracker"

# Clé de l'API DeepL (traduction). Laisse vide pour désactiver la traduction automatique :
# l'appli fonctionne quand même, les traductions sont alors à saisir à la main.
# Les clés du plan gratuit finissent par ":fx". SECRET : jamais dans le code, jamais sur GitHub.
DEEPL_API_KEY=

# Secret qui signe les sessions (les "jetons" de connexion). OBLIGATOIRE, 32 caractères minimum.
# Quiconque le connaît peut se faire passer pour n'importe quel utilisateur : ne le partage JAMAIS.
# Pour en générer un :  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port sur lequel le serveur écoute
PORT=3001

# Adresse du front (pour autoriser ses appels : CORS)
CLIENT_ORIGIN="http://localhost:5173"
