# Modèle du fichier .env : copie ce fichier en ".env" puis remplace VOTRE_MOT_DE_PASSE.
# Le vrai fichier .env ne doit JAMAIS être envoyé sur GitHub (il est ignoré par .gitignore).

# Adresse de la base PostgreSQL : postgresql://utilisateur:mot_de_passe@serveur:port/nom_de_la_base
DATABASE_URL="postgresql://postgres:VOTRE_MOT_DE_PASSE@localhost:5432/vocabtracker"

# Port sur lequel le serveur écoute
PORT=3001

# Adresse du front (pour autoriser ses appels : CORS)
CLIENT_ORIGIN="http://localhost:5173"
